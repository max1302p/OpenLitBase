{
  "name": "@litbase/extension",
  "version": "0.5.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build && wxt build -b firefox --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip && wxt zip -b firefox --mv3",
    "typecheck": "wxt prepare && tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@litbase/shared": "workspace:*",
    "@litbase/ui": "workspace:*",
    "@tanstack/react-query": "^5.103.2",
    "lucide-react": "^1.48.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.0",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
